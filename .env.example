# WiFi settings read at compile time by `option_env!`.
# Rebuild/reflash after changing these values.
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password

# MQTT broker settings read at compile time by `option_env!`.
# `MQTT_BROKER_ADDR`, `MQTT_CLIENT_ID`, and `MQTT_TOPIC_PREFIX` are required.
MQTT_BROKER_ADDR=192.168.1.10
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=esp-pwm-motor
MQTT_TOPIC_PREFIX=desk

# MQTT timing knobs, in seconds.
MQTT_KEEP_ALIVE_SECS=30
MQTT_RECONNECT_DELAY_SECS=5
